{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "PTC_Premium_Architectural_Bold_Website/PTC_Premium_Website",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ptc-premium-admin.vercel.app" }],
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "ptc-premium-admin.vercel.app" }],
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
